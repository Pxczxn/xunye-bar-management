page {
  background-color: #0B0B0F;
  color: #F4EBDD;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  background-color: #1A1A1F;
  border-radius: 16rpx;
  padding: 32rpx;
}

.btn-primary {
  background-color: #D6A85A;
  color: #0B0B0F;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.text-gold {
  color: #D6A85A;
}

.text-main {
  color: #F4EBDD;
}

.text-sub {
  color: #AFA79B;
}

.text-weak {
  color: #6B6560;
}

.border-dark {
  border: 1rpx solid #2A2A31;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
