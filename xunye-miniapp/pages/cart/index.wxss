.cart-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 200rpx;
}

.page-header {
  margin-bottom: 40rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #1e1e24;
}

.header-main {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #F4EBDD;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 20rpx;
  color: #D6A85A;
  letter-spacing: 6rpx;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
  gap: 32rpx;
}

.empty-text { font-size: 30rpx; color: #6B6560; }

.go-menu-btn {
  color: #D6A85A;
  font-size: 28rpx;
  padding: 20rpx 56rpx;
  border: 1rpx solid rgba(214,168,90,0.4);
  border-radius: 8rpx;
}

.go-menu-btn:active { background-color: rgba(214,168,90,0.08); }

.order-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.table-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(214,168,90,0.07);
  border: 1rpx solid rgba(214,168,90,0.2);
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
}

.table-banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #D6A85A;
  flex-shrink: 0;
}

.table-banner-label { font-size: 26rpx; color: #AFA79B; }
.table-banner-name { font-size: 28rpx; color: #D6A85A; font-weight: 500; }

.section-label {
  font-size: 24rpx;
  color: #6B6560;
  letter-spacing: 2rpx;
  padding: 8rpx 0 4rpx;
}

.item-card {
  background-color: #141418;
  border-radius: 14rpx;
  padding: 28rpx;
  border: 1rpx solid #1e1e24;
}

.item-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.item-name-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  margin-right: 20rpx;
}

.item-name { font-size: 30rpx; font-weight: 500; color: #F4EBDD; }
.item-spec { font-size: 22rpx; color: #6B6560; }
.item-unit-price { font-size: 26rpx; color: #D6A85A; flex-shrink: 0; }

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-subtotal { font-size: 24rpx; color: #AFA79B; }

.qty-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #2A2A31;
  color: #F4EBDD;
  font-size: 32rpx;
  border-radius: 8rpx;
}

.qty-btn.disabled { color: #3a3a42; background-color: #1A1A1F; }
.qty-btn:active { opacity: 0.8; }
.qty-num { font-size: 30rpx; color: #F4EBDD; min-width: 40rpx; text-align: center; }

.del-btn {
  font-size: 24rpx;
  color: #6B6560;
  padding: 8rpx 12rpx;
}

.del-btn:active { color: #AFA79B; }

.remark-card {
  background-color: #141418;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #1e1e24;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.remark-label { font-size: 26rpx; color: #AFA79B; flex-shrink: 0; }

.remark-input { flex: 1; color: #F4EBDD; font-size: 28rpx; }
.remark-placeholder { color: #3a3a42; }

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #141418;
  border-top: 1rpx solid #2A2A31;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-total {
  display: flex;
  flex-direction: column;
}

.footer-label { font-size: 22rpx; color: #6B6560; }
.footer-amount { font-size: 44rpx; font-weight: 700; color: #D6A85A; }

.submit-btn {
  background: linear-gradient(135deg, #D6A85A, #C49040);
  color: #0B0B0F;
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 64rpx;
  line-height: 1;
  box-shadow: 0 4rpx 20rpx rgba(214,168,90,0.25);
}

.submit-btn[disabled] { background: #2A2A31; color: #6B6560; box-shadow: none; }
.submit-btn:active { opacity: 0.85; }
