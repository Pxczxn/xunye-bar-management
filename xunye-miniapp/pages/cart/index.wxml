<view class="cart-page">
  <view class="page-header">
    <text class="header-main">确认订单</text>
    <text class="header-sub">ORDER CONFIRM</text>
  </view>

  <view wx:if="{{cartItems.length === 0}}" class="empty-box">
    <text class="empty-text">购物车还是空的</text>
    <view class="go-menu-btn" bindtap="onGoMenu">去点单</view>
  </view>

  <view wx:else class="order-body">
    <view wx:if="{{tableName}}" class="table-banner">
      <view class="table-banner-dot"></view>
      <text class="table-banner-label">当前桌台</text>
      <text class="table-banner-name">{{tableName}}</text>
    </view>

    <text class="section-label">商品明细</text>

    <view wx:for="{{cartItems}}" wx:key="productId" class="item-card">
      <view class="item-top">
        <view class="item-name-wrap">
          <text class="item-name">{{item.name}}</text>
          <text wx:if="{{item.spec}}" class="item-spec">{{item.spec}}</text>
        </view>
        <text class="item-unit-price">¥{{item.priceFormatted}}/{{item.unit}}</text>
      </view>
      <view class="item-bottom">
        <text class="item-subtotal">小计 ¥{{item.subtotal}}</text>
        <view class="qty-row">
          <view class="qty-btn {{item.quantity <= 1 ? 'disabled' : ''}}" data-index="{{index}}" bindtap="onQuantityReduce">-</view>
          <text class="qty-num">{{item.quantity}}</text>
          <view class="qty-btn {{item.quantity >= item.stock ? 'disabled' : ''}}" data-index="{{index}}" bindtap="onQuantityAdd">+</view>
        </view>
        <view class="del-btn" data-index="{{index}}" bindtap="onDelete">删除</view>
      </view>
    </view>

    <view class="remark-card">
      <text class="remark-label">备注</text>
      <input class="remark-input" placeholder="少冰、不要辣..." placeholder-class="remark-placeholder" value="{{remark}}" bindinput="onRemarkInput" maxlength="100" />
    </view>
  </view>

  <view wx:if="{{cartItems.length > 0}}" class="footer">
    <view class="footer-total">
      <text class="footer-label">合计</text>
      <text class="footer-amount">¥{{totalAmount}}</text>
    </view>
    <button class="submit-btn" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '提交订单'}}
    </button>
  </view>
</view>
