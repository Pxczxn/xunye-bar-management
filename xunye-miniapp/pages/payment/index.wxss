.pay-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 48rpx 32rpx;
}

.pay-header {
  margin-bottom: 48rpx;
}

.pay-header-main {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #F4EBDD;
  margin-bottom: 8rpx;
}

.pay-header-sub {
  font-size: 20rpx;
  color: #D6A85A;
  letter-spacing: 6rpx;
}

.amount-hero {
  background: linear-gradient(135deg, #1a1208 0%, #141418 100%);
  border: 1rpx solid rgba(214,168,90,0.2);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.amount-label {
  font-size: 26rpx;
  color: #AFA79B;
  margin-bottom: 16rpx;
}

.amount-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #D6A85A;
  line-height: 1;
}

.amount-sym {
  font-size: 36rpx;
  font-weight: 400;
  vertical-align: super;
}

.info-card {
  background-color: #141418;
  border-radius: 16rpx;
  border: 1rpx solid #1e1e24;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid #1e1e24;
}

.info-label { font-size: 28rpx; color: #AFA79B; }
.info-value { font-size: 28rpx; color: #F4EBDD; }

.pay-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #D6A85A, #C49040);
  color: #0B0B0F;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 32rpx rgba(214,168,90,0.28);
}

.pay-btn[disabled] { background: #2A2A31; color: #6B6560; box-shadow: none; }
.pay-btn:active { opacity: 0.85; }

.refresh-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 24rpx;
  background: transparent;
  color: #D6A85A;
  border: 1rpx solid rgba(214,168,90,0.45);
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.refresh-btn[disabled] {
  color: #6B6560;
  border-color: #2A2A31;
}

.refresh-btn:active { opacity: 0.85; }

.pay-note {
  text-align: center;
  font-size: 22rpx;
  color: #6B6560;
  margin-top: 24rpx;
}
