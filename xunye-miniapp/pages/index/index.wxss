.home {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 56rpx;
  background: radial-gradient(ellipse at 50% 30%, #1a1208 0%, #0B0B0F 65%);
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.brand-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(214,168,90,0.55);
  box-shadow: 0 0 48rpx rgba(214,168,90,0.12), inset 0 0 40rpx rgba(214,168,90,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 300;
  color: #D6A85A;
  letter-spacing: 16rpx;
}

.brand-en {
  display: block;
  font-size: 22rpx;
  color: #D6A85A;
  letter-spacing: 10rpx;
  margin-bottom: 20rpx;
}

.brand-tagline {
  font-size: 24rpx;
  color: #6B6560;
  letter-spacing: 4rpx;
}

.table-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: rgba(214,168,90,0.07);
  border: 1rpx solid rgba(214,168,90,0.25);
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  margin-bottom: 64rpx;
}

.table-chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #D6A85A;
  flex-shrink: 0;
}

.table-chip-text {
  font-size: 26rpx;
  color: #D6A85A;
}

.action { width: 100%; }

.btn-start {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #D6A85A 0%, #C49040 100%);
  color: #0B0B0F;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 32rpx rgba(214,168,90,0.28);
}

.btn-start:active { opacity: 0.85; }
