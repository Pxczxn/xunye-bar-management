.select-page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
}

.page-header {
  margin-bottom: 48rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #1e1e24;
}

.header-main {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #F4EBDD;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 20rpx;
  color: #D6A85A;
  letter-spacing: 6rpx;
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #2A2A31;
  border-top-color: #D6A85A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.link-btn {
  color: #D6A85A;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border: 1rpx solid rgba(214,168,90,0.4);
  border-radius: 8rpx;
}

.table-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.table-card {
  background-color: #141418;
  border: 1rpx solid #2A2A31;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.table-card.selected {
  border-color: #D6A85A;
  background-color: rgba(214,168,90,0.06);
}

.table-card:active { opacity: 0.8; }

.table-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #F4EBDD;
  margin-bottom: 10rpx;
}

.table-area {
  font-size: 24rpx;
  color: #AFA79B;
}

.selected-mark {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  font-size: 28rpx;
  color: #D6A85A;
  font-weight: 600;
}
