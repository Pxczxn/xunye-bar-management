<view class="select-page">
  <view class="page-header">
    <text class="header-main">选择桌台</text>
    <text class="header-sub">SELECT YOUR TABLE</text>
  </view>

  <view wx:if="{{loading}}" class="state-box">
    <view class="spinner"></view>
    <text class="text-sub">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="state-box">
    <text class="text-sub">加载失败</text>
    <view class="link-btn" bindtap="onRetry">重试</view>
  </view>

  <view wx:elif="{{tables.length === 0}}" class="state-box">
    <text class="text-sub">暂无可用桌台</text>
  </view>

  <view wx:else class="table-grid">
    <view wx:for="{{tables}}" wx:key="id"
          class="table-card {{currentTableId === item.id ? 'selected' : ''}}"
          data-table="{{item}}" bindtap="onSelect">
      <text class="table-num">{{item.name}}</text>
      <text class="table-area">{{item.areaName}}</text>
      <view wx:if="{{currentTableId === item.id}}" class="selected-mark">✓</view>
    </view>
  </view>
</view>
