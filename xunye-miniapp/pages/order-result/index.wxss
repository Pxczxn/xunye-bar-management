.result-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #D6A85A;
  color: #0B0B0F;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #F4EBDD;
  margin-bottom: 12rpx;
}

.result-sub {
  margin-bottom: 48rpx;
}

.order-info {
  width: 100%;
  margin-bottom: 48rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid #2A2A31;
}

.info-label {
  font-size: 28rpx;
}

.info-value {
  font-size: 28rpx;
}

.btn-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-group .btn-primary {
  width: 100%;
}

.btn-outline {
  width: 100%;
  background-color: transparent;
  color: #D6A85A;
  border: 1rpx solid #D6A85A;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  line-height: 1;
}

.btn-outline:active {
  opacity: 0.85;
}
