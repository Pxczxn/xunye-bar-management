<view class="menu-page">
  <view class="topbar">
    <view class="search-row">
      <view class="search-box">
        <input class="search-input" placeholder="搜索酒水" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch"/>
        <view class="search-btn" bindtap="onSearch">搜索</view>
      </view>
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onSearchClear">清除</view>
    </view>
    <view wx:if="{{tableName}}" class="table-bar">
      <view class="table-bar-dot"></view>
      <text class="table-bar-text">{{tableName}}</text>
    </view>
  </view>

  <view class="main-area">
    <view class="category-list">
      <view wx:for="{{categories}}" wx:key="id"
            class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}" bindtap="onCategoryTap">
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>

    <view class="product-area">
      <view wx:if="{{loading}}" class="state-box">
        <view class="spinner"></view>
        <text class="text-sub">加载中...</text>
      </view>
      <view wx:elif="{{error}}" class="state-box">
        <text class="text-sub">加载失败</text>
        <view class="link-btn" bindtap="onRetry">重试</view>
      </view>
      <view wx:elif="{{products.length === 0}}" class="state-box">
        <text class="text-weak">暂无商品</text>
      </view>
      <view wx:else class="product-list">
        <view wx:for="{{products}}" wx:key="id" class="product-card">
          <view class="product-name">{{item.name}}</view>
          <view class="product-meta">{{item.categoryName}}<text wx:if="{{item.spec}}"> · {{item.spec}}</text></view>
          <view wx:if="{{item.description}}" class="product-desc">{{item.description}}</view>
          <view class="product-footer">
            <view class="product-price">
              <text class="price-sym">¥</text>
              <text class="price-val">{{item.priceFormatted}}</text>
              <text class="price-unit">/{{item.unit}}</text>
            </view>
            <view class="product-right">
              <text class="product-stock">库存 {{item.stock}}</text>
              <view wx:if="{{item.stock > 0}}" class="add-btn" data-product="{{item}}" bindtap="onAddToCart">加入</view>
              <view wx:else class="sold-out">售罄</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{cartCount > 0}}" class="cart-bar">
    <view class="cart-bar-left">
      <view class="cart-badge">{{cartCount}}</view>
      <text class="cart-total">¥{{cartTotal}}</text>
    </view>
    <view class="cart-bar-btn" bindtap="onGoCart">去结算</view>
  </view>
</view>
