<view class="detail-page">
  <view class="page-header">
    <view>
      <text class="header-main">订单详情</text>
      <text class="header-sub">ORDER DETAIL</text>
    </view>
    <button class="header-refresh" bindtap="onRefreshStatus" disabled="{{refreshing || loading}}">
      {{refreshing ? '刷新中' : '刷新状态'}}
    </button>
  </view>

  <view wx:if="{{loading}}" class="state-box">
    <view class="spinner"></view>
    <text class="text-sub">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="state-box">
    <text class="text-sub">加载失败</text>
    <view class="link-btn" bindtap="onRetry">重试</view>
  </view>

  <view wx:elif="{{order}}" class="order-body">
    <view class="status-banner {{order.status === 'PAID' ? 'paid' : order.status === 'CANCELLED' ? 'cancelled' : 'unpaid'}}">
      <view class="status-item">
        <text class="status-item-label">支付状态</text>
        <text class="status-item-value text-gold">{{order.statusText}}</text>
      </view>
      <view class="status-divider"></view>
      <view class="status-item">
        <text class="status-item-label">制作状态</text>
        <text class="status-item-value text-main">{{order.serveStatusText}}</text>
      </view>
    </view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">桌台</text>
        <text class="info-value">{{order.tableName || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">总金额</text>
        <text class="info-value gold">¥{{order.totalAmountFormatted}}</text>
      </view>
      <view wx:if="{{order.remark}}" class="info-row">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <text class="section-label">商品明细</text>

    <view class="item-list">
      <view wx:for="{{order.items}}" wx:key="id" class="item-card">
        <view class="item-left">
          <text class="item-name">{{item.productName}}</text>
          <text class="item-qty">x{{item.quantity}} · 单价 ¥{{item.priceFormatted}}</text>
        </view>
        <text class="item-amount">¥{{item.amountFormatted}}</text>
      </view>
    </view>
  </view>
</view>
