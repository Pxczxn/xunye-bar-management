.detail-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
}

.page-header {
  margin-bottom: 40rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #1e1e24;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.header-main {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #F4EBDD;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 20rpx;
  color: #D6A85A;
  letter-spacing: 6rpx;
}

.header-refresh {
  min-width: 144rpx;
  height: 56rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  margin: 0;
  background: rgba(214,168,90,0.08);
  border: 1rpx solid rgba(214,168,90,0.35);
  border-radius: 28rpx;
  color: #D6A85A;
  font-size: 24rpx;
}

.header-refresh[disabled] {
  color: #6B6560;
  border-color: #2A2A31;
  background: transparent;
}

.header-refresh:active { opacity: 0.85; }

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #2A2A31;
  border-top-color: #D6A85A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.link-btn {
  color: #D6A85A;
  font-size: 28rpx;
  padding: 14rpx 40rpx;
  border: 1rpx solid rgba(214,168,90,0.4);
  border-radius: 8rpx;
}

.order-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 状态横幅 */
.status-banner {
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-banner.paid {
  background: linear-gradient(135deg, rgba(214,168,90,0.12), rgba(214,168,90,0.05));
  border: 1rpx solid rgba(214,168,90,0.25);
}

.status-banner.unpaid {
  background-color: #141418;
  border: 1rpx solid #2A2A31;
}

.status-banner.cancelled {
  background-color: #141418;
  border: 1rpx solid #2A2A31;
  opacity: 0.6;
}

.status-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-item-label {
  font-size: 22rpx;
  color: #6B6560;
}

.status-item-value {
  font-size: 30rpx;
  font-weight: 600;
}

.status-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #2A2A31;
}

/* 信息卡片 */
.info-card {
  background-color: #141418;
  border-radius: 16rpx;
  border: 1rpx solid #1e1e24;
  overflow: hidden;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx;
}

.info-row + .info-row { border-top: 1rpx solid #1e1e24; }
.info-label { font-size: 28rpx; color: #AFA79B; }
.info-value { font-size: 28rpx; color: #F4EBDD; }
.info-value.gold { color: #D6A85A; font-weight: 600; }

/* 商品明细 */
.section-label {
  font-size: 24rpx;
  color: #6B6560;
  letter-spacing: 2rpx;
  padding: 4rpx 0;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-card {
  background-color: #141418;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #1e1e24;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-left { display: flex; flex-direction: column; gap: 6rpx; }
.item-name { font-size: 30rpx; font-weight: 500; color: #F4EBDD; }
.item-qty { font-size: 24rpx; color: #6B6560; }
.item-amount { font-size: 32rpx; font-weight: 600; color: #D6A85A; }
